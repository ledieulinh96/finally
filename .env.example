# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: "true" to fetch real (15-min delayed) KOSPI/KOSDAQ prices via yfinance.
USE_YFINANCE=false

# Optional: OpenDART API key for company fundamentals (https://opendart.fss.or.kr)
OPENDART_API_KEY=

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional, dev tooling only: Gemini API key for the Claude Code Gemini review hook
GEMINI_API_KEY=
